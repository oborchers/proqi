#!/usr/bin/expect -f

set timeout 15
set binary [lindex $argv 0]
set state [lindex $argv 1]

proc pause {milliseconds} {
    set ::pause_complete 0
    after $milliseconds {set ::pause_complete 1}
    vwait ::pause_complete
}

proc type_text {text delay} {
    foreach character [split $text ""] {
        send -- $character
        pause $delay
    }
}

if {$binary eq "" || $state eq ""} {
    puts stderr "usage: readme-demo-record.exp <binary> <state-directory>"
    exit 2
}

# The cast renderer supports true color. Declare that capability explicitly in
# the spawned terminal so Proqi can resolve its automatic palette.
set env(TERM) xterm-256color
set env(COLORTERM) truecolor
catch {unset env(NO_COLOR)}
spawn -noecho $binary --state-dir $state -c
set terminal_channel [exp_open -leaveopen]
exec stty rows 30 columns 92 <@ $terminal_channel

# The recorder uses automatic theme detection. Answer a bounded palette probe
# when Proqi requests one; some nested PTYs provide enough color information
# without it. The reference colors are foreground #c9cde0 and background #181922,
# matching the visual contract snapshots.
set board_ready 0
while {!$board_ready} {
    expect {
        -exact "\033]10;?" {
            send -- "\033]10;rgb:c9c9/cdcd/e0e0\007"
        }
        -exact "\033]11;?" {
            send -- "\033]11;rgb:1818/1919/2222\007"
        }
        -exact "\033\[c" {
            send -- "\033\[?1;2c"
        }
        -re {release} {
            set board_ready 1
        }
        timeout {
            puts stderr "timed out waiting for the README demo board"
            exit 1
        }
    }
}
expect_background -re {.+} {}
pause 800

send -- "\033\[B"
pause 700
send -- "\033\[B"
pause 700
send -- "\033\[B"
pause 700
send -- "\033\[B"
pause 700

send -- "d"
pause 800
send -- "n"
pause 300
type_text "Ask the agent to verify the release archive." 24
pause 700
send -- "\033"
pause 700

send -- "\r"
pause 500
type_text " before publishing." 24
pause 700
send -- "\033"
pause 700

send -- "K"
pause 700
send -- "K"
pause 700
send -- " "
pause 500
send -- "k"
pause 500
send -- " "
pause 700
send -- "y"
pause 900

# Duplicate the selected pair with Command-D, then delete the duplicates as
# one board operation. Kitty keyboard protocol encodes Super as modifier 9.
send -- "\033\[100;9u"
pause 1000
send -- "d"
pause 1600

expect_background
send -- "q"
expect -re {Resume later:}
expect eof
wait
exit 0

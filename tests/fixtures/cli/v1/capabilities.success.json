{
  "data": {
    "active_session_control": true,
    "active_session_read_sync": true,
    "atomic_named_sessions": true,
    "bounded_lists": true,
    "cli_schema_version": 1,
    "commands": ["capabilities", "completions", "update", "diagnostics", "doctor", "sessions", "items", "thoughts"],
    "control_protocol": 11,
    "cross_session_transfer": true,
    "durable_browser_history": true,
    "durable_thought_collapse": true,
    "durable_visual_separators": true,
    "error_codes": [
      {"code": "invalid_arguments", "exit": 2, "retry": "no"},
      {"code": "invalid_input", "exit": 2, "retry": "no"},
      {"code": "invalid_identifier", "exit": 2, "retry": "no"},
      {"code": "config_invalid", "exit": 2, "retry": "no"},
      {"code": "invalid_shortcut_context", "exit": 2, "retry": "no"},
      {"code": "unsafe_state_path", "exit": 2, "retry": "no"},
      {"code": "session_not_found", "exit": 3, "retry": "after_change"},
      {"code": "thought_not_found", "exit": 3, "retry": "after_change"},
      {"code": "not_found", "exit": 3, "retry": "after_change"},
      {"code": "cursor_not_found", "exit": 3, "retry": "after_change"},
      {"code": "ambiguous_session", "exit": 4, "retry": "after_change"},
      {"code": "session_busy", "exit": 5, "retry": "yes"},
      {"code": "schema_busy", "exit": 5, "retry": "yes"},
      {"code": "storage_busy", "exit": 5, "retry": "yes"},
      {"code": "unsupported", "exit": 6, "retry": "no"},
      {"code": "protocol_mismatch", "exit": 6, "retry": "no"},
      {"code": "session_trashed", "exit": 7, "retry": "after_change"},
      {"code": "session_not_trashed", "exit": 7, "retry": "after_change"},
      {"code": "session_name_conflict", "exit": 7, "retry": "after_change"},
      {"code": "history_unavailable", "exit": 7, "retry": "after_change"},
      {"code": "idempotency_conflict", "exit": 7, "retry": "no"},
      {"code": "no_change", "exit": 7, "retry": "no"},
      {"code": "content_conflict", "exit": 7, "retry": "after_change"},
      {"code": "thought_locked", "exit": 7, "retry": "after_change"},
      {"code": "invalid_state", "exit": 7, "retry": "after_change"},
      {"code": "invariant_violation", "exit": 7, "retry": "no"},
      {"code": "conflict", "exit": 7, "retry": "after_change"},
      {"code": "mutation_rejected", "exit": 7, "retry": "after_change"},
      {"code": "operation_indeterminate", "exit": 8, "retry": "same_identity"},
      {"code": "storage_failed", "exit": 1, "retry": "after_change"},
      {"code": "storage_full", "exit": 1, "retry": "after_change"},
      {"code": "disk_full", "exit": 1, "retry": "after_change"},
      {"code": "recovery_capacity", "exit": 1, "retry": "after_change"},
      {"code": "runtime_failed", "exit": 1, "retry": "after_change"},
      {"code": "runtime_metadata_invalid", "exit": 1, "retry": "after_change"},
      {"code": "terminal_failed", "exit": 1, "retry": "after_change"},
      {"code": "terminal_worker_failed", "exit": 1, "retry": "after_change"},
      {"code": "terminal_cleanup_failed", "exit": 1, "retry": "after_change"},
      {"code": "control_failed", "exit": 1, "retry": "after_change"},
      {"code": "output_failed", "exit": 1, "retry": "after_change"},
      {"code": "environment_failed", "exit": 1, "retry": "after_change"},
      {"code": "diagnostics_failed", "exit": 1, "retry": "after_change"},
      {"code": "doctor_failed", "exit": 1, "retry": "after_change"},
      {"code": "installation_failed", "exit": 1, "retry": "after_change"},
      {"code": "installation_unverified", "exit": 1, "retry": "after_change"},
      {"code": "installed_version_invalid", "exit": 1, "retry": "no"},
      {"code": "invalid_build_version", "exit": 1, "retry": "no"},
      {"code": "obsolete_executable", "exit": 1, "retry": "no"},
      {"code": "update_convergence_active", "exit": 1, "retry": "yes"},
      {"code": "external_upgrade_pending", "exit": 1, "retry": "after_change"},
      {"code": "external_upgrade_blocked", "exit": 1, "retry": "after_change"},
      {"code": "external_upgrade_capacity", "exit": 1, "retry": "after_change"},
      {"code": "external_upgrade_incomplete", "exit": 1, "retry": "after_change"},
      {"code": "external_upgrade_persistence_failed", "exit": 1, "retry": "after_change"},
      {"code": "update_network_failed", "exit": 1, "retry": "yes"},
      {"code": "update_response_invalid", "exit": 1, "retry": "after_change"},
      {"code": "update_response_too_large", "exit": 1, "retry": "after_change"},
      {"code": "update_state_failed", "exit": 1, "retry": "after_change"},
      {"code": "update_coordination_failed", "exit": 1, "retry": "after_change"},
      {"code": "update_installation_failed", "exit": 1, "retry": "after_change"}
    ],
    "exact_text_transformations": true,
    "exact_thought_replacement": true,
    "explicit_update_check": true,
    "herdr_managed_pane_required": true,
    "herdr_submission": true,
    "idempotent_session_trash": true,
    "identifier_encoding": "prefix_base32hex_uuidv7",
    "json_help_and_version": true,
    "max_thought_stdin_bytes": 131072,
    "mixed_board_item_mutations": true,
    "named_thought_creation": true,
    "operations": {
      "diagnostics": ["collect", "keypress"],
      "history_scopes": ["board", "editor", "browser"],
      "items": ["insert-separator", "move", "delete", "duplicate"],
      "sessions": ["list", "ensure", "create", "rename", "trash", "restore", "undo", "redo", "prune"],
      "thoughts": ["list", "inspect", "add", "delete", "rename", "replace", "collapse", "move", "split", "extract", "merge", "reflow", "send", "undo", "redo"],
      "update": ["check"]
    },
    "options": {
      "items": {
        "delete": ["operation-id"],
        "duplicate": ["operation-id"],
        "insert-separator": ["position", "operation-id"],
        "move": ["operation-id"]
      },
      "sessions": {
        "create": ["name", "cwd", "operation-id"],
        "ensure": ["name", "cwd"],
        "list": ["query", "all", "limit", "after"],
        "prune": ["yes", "operation-id"],
        "redo": ["operation-id"],
        "rename": ["clear", "operation-id"],
        "restore": ["operation-id"],
        "trash": ["operation-id"],
        "undo": ["operation-id"]
      },
      "thoughts": {
        "add": ["name", "position", "operation-id"],
        "collapse": ["collapsed", "operation-id"],
        "delete": ["operation-id"],
        "extract": ["expected-sha256", "operation-id"],
        "inspect": [],
        "list": ["limit", "after"],
        "merge": ["expected-sha256", "operation-id"],
        "move": ["operation-id"],
        "redo": ["thought", "operation-id"],
        "reflow": ["expected-sha256", "operation-id"],
        "rename": ["clear", "operation-id"],
        "replace": ["revision-id", "expected-sha256", "force"],
        "send": ["remove", "operation-id", "remove-operation-id"],
        "split": ["expected-sha256", "operation-id"],
        "undo": ["thought", "operation-id"]
      }
    },
    "replacement_sha256_precondition": true,
    "semantic_separator_mutations": true,
    "session_operation_identity": true
  },
  "ok": true,
  "schema_version": 1
}
